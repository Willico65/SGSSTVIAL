# Copia este archivo a .env.local para desarrollo local (no se commitea).
# En producción, define estas mismas variables en Vercel → Project Settings → Environment Variables.

# API key de Resend (resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Remitente del correo. Antes de verificar un dominio propio en Resend,
# usa el remitente de pruebas de Resend (solo puede enviar al correo con el
# que te registraste en Resend):
RESEND_FROM_EMAIL="Sisstvial Web <onboarding@resend.dev>"

# Correo que recibe los mensajes del formulario de contacto.
CONTACT_TO_EMAIL=sisstvial@gmail.com
